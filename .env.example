# =============================================================================
# Variables de entorno del ecosistema (docker compose las lee de ./.env)
#   cp .env.example .env
# Nunca subas el archivo .env al repositorio.
# =============================================================================

# ---------------------------------------------------------------------------
# Puertos publicados en el host
# ---------------------------------------------------------------------------
# Frontend Next.js -> http://localhost:3000
FRONTEND_PORT=3000
# API Laravel (Nginx) -> http://localhost:8000/api
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# API Laravel
# ---------------------------------------------------------------------------
APP_NAME="Ecommerce API"
# URL pública de la API (se usa en enlaces generados y en Swagger)
APP_URL=http://localhost:8000
# Clave de cifrado de Laravel (OBLIGATORIA). Generar con:
#   docker compose build php
#   docker compose run --rm --no-deps --entrypoint php php artisan key:generate --show
APP_KEY=
# Secreto para firmar los JWT (OBLIGATORIO). Generar con:
#   openssl rand -base64 48
JWT_SECRET=
# Nivel de log enviado a stderr (debug, info, warning, error)
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Base de datos MySQL (compartidas por el servicio db y la API)
# ---------------------------------------------------------------------------
DB_DATABASE=ecomerce
DB_USERNAME=ecomerce
# Contraseña del usuario de la aplicación (OBLIGATORIA)
DB_PASSWORD=cambia-esta-clave
# Contraseña del usuario root de MySQL (OBLIGATORIA, distinta a la anterior)
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# ---------------------------------------------------------------------------
# Stripe (modo test) — opcionales; sin ellas el catálogo funciona pero no el pago
# ---------------------------------------------------------------------------
# Clave secreta, empieza con "sk_test_" (solo la usa la API)
STRIPE_SECRET_KEY=
# Secreto de firma del webhook, empieza con "whsec_" (stripe listen --forward-to localhost:8000/api/payments/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Clave publicable, empieza con "pk_test_" (se incrusta en el frontend en tiempo de BUILD: reconstruye si cambia)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
